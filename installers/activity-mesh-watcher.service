[Unit]
Description=activity-mesh fswatch capture daemon
After=network.target
Documentation=https://github.com/Surdeddd/activity-mesh

[Service]
Type=simple
ExecStart=/usr/local/bin/activity-watcher --config %h/.config/activity-mesh/watcher.yaml
Restart=on-failure
RestartSec=30
StandardError=append:%h/.local/state/activity-mesh/watcher.err.log
StandardOutput=append:%h/.local/state/activity-mesh/watcher.out.log
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Nice=5

# Resource caps (defensive, fswatch is light)
MemoryMax=256M
CPUQuota=20%

[Install]
WantedBy=default.target
